emscripten: no pthread_getaffinity_np.

configure detects it with a compile test only; emscripten declares it
without defining it (undefined symbol at link time).  Later versions test
it by linking.

--- a/runtime/domain.c
+++ b/runtime/domain.c
@@
-#if defined(HAS_GNU_GETAFFINITY_NP) || defined(HAS_BSD_GETAFFINITY_NP)
+/* emscripten declares pthread_getaffinity_np but does not define it, which
+   configure, testing it by compilation only, does not notice. */
+#if (defined(HAS_GNU_GETAFFINITY_NP) || defined(HAS_BSD_GETAFFINITY_NP)) \
+    && !defined(__EMSCRIPTEN__)
