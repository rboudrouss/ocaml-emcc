emscripten: commit reserved memory with mprotect.

OCaml 5 reserves the minor heap with mmap(PROT_NONE) and commits it with
mmap(MAP_FIXED), which emscripten does not implement ("Failed to create
main domain").  Use the mprotect-based variant already used for Cygwin.

--- a/runtime/unix.c
+++ b/runtime/unix.c
@@ -482,7 +482,9 @@
   return;
 }
 
-#ifndef __CYGWIN__
+/* emscripten: mmap(MAP_FIXED) over a reservation is not supported, commit
+   with mprotect like on Cygwin (a no-op there: memory is always accessible). */
+#if !defined(__CYGWIN__) && !defined(__EMSCRIPTEN__)
 
 /* Standard Unix implementation: reserve with mmap (and trim to alignment) with
    commit done using mmap as well. */
