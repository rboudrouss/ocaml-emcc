emscripten: a domain starts without a signal stack.

Without POSIX signals (no sigaltstack in emscripten, see the recipe),
caml_init_signal_stack returns NULL, which the thread of a new domain takes
for a failure ("Failed to create domain: signal stack").  It returns a
pointer to nothing instead, which caml_free_signal_stack ignores there.

--- a/runtime/signals.c
+++ b/runtime/signals.c
@@
   return stk.ss_sp;
 #else
+#ifdef __EMSCRIPTEN__
+  static char no_signal_stack;
+  return &no_signal_stack;
+#else
   return NULL;
+#endif
 #endif /* POSIX_SIGNALS */
 }
