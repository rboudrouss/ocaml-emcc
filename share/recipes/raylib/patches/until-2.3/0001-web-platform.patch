emscripten: build the vendored raylib for PLATFORM_WEB in the target's
context (dune -x).

There, %{system} is still the host's: the desktop rules would build it
with the host's compiler and its X11 backend.  PLATFORM_WEB uses
emscripten's GLFW and WebGL instead, compiled by the context's %{cc}
(the target's flags, -sMEMORY64 on wasm64).  ocamlmklib is the
toolchain's: libraylib.a from the wasm objects, and a host placeholder
for dllraylib.so.  The helpers are the host's (%{exe:...}, outside
no-infer so that dune builds them).

--- a/src/c/dune
+++ b/src/c/dune
@@
  (targets libraylib.a dllraylib.so)
  (enabled_if
-  (or
-   (= %{system} linux)
-   (= %{system} linux_elf)
-   (= %{system} elf)))
+  (and
+   (= %{context_name} default)
+   (or
+    (= %{system} linux)
+    (= %{system} linux_elf)
+    (= %{system} elf))))
  (deps
@@
     (copy vendor/raylib/src/libraylib.so.6.0.0 dllraylib.so)))))

+(rule
+ (alias build-raylib)
+ (targets libraylib.a dllraylib.so)
+ (enabled_if
+  (<> %{context_name} default))
+ (deps
+  (source_tree vendor/raylib)
+  enable_formats.patch
+  hotfixes.patch)
+ (action
+  (progn
+   (run %{exe:chmodx.exe} vendor/raylib/src/config.h)
+   (run %{exe:apply_patch.exe} enable_formats.patch)
+   (run %{exe:chmodx.exe} vendor/raylib/src/platforms/rcore_desktop_glfw.c)
+   (run %{exe:chmodx.exe} vendor/raylib/src/raudio.c)
+   (run %{exe:apply_patch.exe} hotfixes.patch)
+   (no-infer
+    (progn
+     (system
+      "make -C vendor/raylib/src PLATFORM=PLATFORM_WEB RAYLIB_LIBTYPE=STATIC CC='%{cc}' AR=emar")
+     (system "ocamlmklib -o raylib vendor/raylib/src/*.o")
+     (system "rm vendor/raylib/src/libraylib.web.a"))))))
+
 (rule
  (alias build-raylib)
  (targets libraylib.a dllraylib.so)
  (enabled_if
-  (= %{system} macosx))
+  (and
+   (= %{context_name} default)
+   (= %{system} macosx)))
  (deps
@@
  (enabled_if
   (and
+   (= %{context_name} default)
    (= %{system} mingw64)
    (<> %{os_distribution} msys2)))
@@
  (enabled_if
   (and
+   (= %{context_name} default)
    (= %{system} mingw64)
    (= %{os_distribution} msys2)))
@@
  (enabled_if
-  (or
-   (= %{system} netbsd)
+  (and
+   (= %{context_name} default)
+   (or
+   (= %{system} netbsd)
@@
-   (= %{system} bsd_elf)))
+   (= %{system} bsd_elf))))
