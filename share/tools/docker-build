#!/bin/sh
# Run in the container of `ocaml-emcc build --docker` (src/docker.ml): builds
# a dune executable with the container's 32-bit OCaml, as plain bytecode,
# through the ocamlc wrapper of the wasm toolchains (tools/ocamlc), which
# records the C flags of the linked libraries in SYSROOT/meta/cclibs (that
# directory of the host is mounted).  The wrapper's C compiler is the
# container's cc: the project's stubs and dune-configurator tests are those
# of the 32-bit platform (the stubs are not used: the host's wasm ones are).
#   docker-build ROOT BUILD_DIR SYSROOT TARGET...
# Builds the first TARGET that dune can build, and prints it.
set -eu
root=$1 bdir=$2 sysroot=$3; shift 3
tools=$(cd "$(dirname "$0")" && pwd)
# the switch's environment is the image's (no opam call: it would lock the
# root, which this user cannot write)
bin=$OPAM_SWITCH_PREFIX/bin lib=$OPAM_SWITCH_PREFIX/lib
t=/tmp/ocaml-emcc-toolchain
mkdir -p "$t/bin" "$t/findlib.conf.d"
cat > "$t/bin/ocamlc" <<EOF
#!/bin/sh
OCAML_EMCC_HOST_BIN='$bin'
OCAML_EMCC_SYSROOT='$sysroot'
OCAML_EMCC_CFLAGS='-O2'
OCAML_EMCC_EMCC=cc
export OCAML_EMCC_HOST_BIN OCAML_EMCC_SYSROOT OCAML_EMCC_CFLAGS OCAML_EMCC_EMCC
exec sh '$tools/ocamlc' "\$@"
EOF
chmod +x "$t/bin/ocamlc"
# no ocamlopt next to the toolchain's ocamlc: a bytecode-only context
for tool in ocaml ocamllex ocamlyacc ocamlobjinfo ocamlcp ocamlmktop ocamlprof; do
  if [ -x "$bin/$tool" ]; then ln -sf "$bin/$tool" "$t/bin/$tool"; fi
done
printf 'destdir="%s"\npath="%s"\n' "$lib" "$lib/ocaml:$lib" > "$t/findlib.conf"
for tool in ocamlc ocamlmklib ocamldep ocamldoc; do echo "$tool=\"$tool\"" >> "$t/findlib.conf"; done
cat > "$t/findlib.conf.d/docker32.conf" <<EOF
path(docker32) = "$lib/ocaml:$lib"
destdir(docker32) = "$lib"
stdlib(docker32) = "$(ocamlc -where)"
ocamlc(docker32) = "$t/bin/ocamlc"
ocamlmklib(docker32) = "$bin/ocamlmklib"
ocamldep(docker32) = "$bin/ocamldep"
ocamldoc(docker32) = "$bin/ocamldoc"
EOF
printf '(lang dune 3.0)\n(context (default (toolchain docker32)))\n' > "$t/workspace"
cd "$root"
for target; do
  if OCAMLFIND_CONF=$t/findlib.conf dune build --root . --build-dir "$bdir" --workspace "$t/workspace" \
       "$target" 2> "$t/err"; then
    cat "$t/err" >&2
    echo "$target"
    exit 0
  fi
done
cat "$t/err" >&2
exit 1
