#!/bin/sh
# gcc and cc of the image of `ocaml-emcc build --docker` (src/docker.ml),
# once its OCaml is built: C compiled with the headers of emscripten
# (OCAML_EMCC_EMINCLUDE, its sysroot) and of the libraries built for the
# target (OCAML_EMCC_INCLUDE) instead of glibc's, so that what a build
# computes from them (errno values, libffi's ABI, struct stat...) is that of
# the target, and with OCAML_EMCC_ABI_FLAGS, which give the C layouts of the
# target (-malign-double -m128bit-long-double on i386).  The programs are
# still linked with glibc: right for the generators that print constants,
# sizes and offsets, not for C code calling the system through structs of
# its headers.  C++ is compiled as is.
[ -n "${OCAML_EMCC_EMINCLUDE:-}" ] || exec /usr/bin/gcc "$@"
for a; do
  case $a in -xc++*|*.cc|*.cpp|*.cxx|*.C) exec /usr/bin/gcc "$@" ;; esac
done
# shellcheck disable=SC2086
exec /usr/bin/gcc -nostdinc -isystem "$(/usr/bin/gcc -print-file-name=include)" \
  -isystem "$OCAML_EMCC_EMINCLUDE" -idirafter "$OCAML_EMCC_INCLUDE" -D__EMSCRIPTEN__ \
  ${OCAML_EMCC_ABI_FLAGS:-} "$@"
