#!/bin/sh
# Run as root in the image of `ocaml-emcc build --docker` (src/docker.ml):
# opam install SPEC...  OCaml 5 has no 32-bit native compiler: the switch is
# bytecode only, and an opam repository ranked first fixes what assumes one:
# - dune, whose (ctypes) stanza links its generators natively only: they are
#   linked as custom bytecode when there is no ocamlopt, as dune does for
#   ppx drivers and cinaps (Exe.Linkage.native_or_custom);
# - the packages conflicting with ocaml-option-bytecode-only for that reason
#   (zstd): the conflict is dropped.
# dune, a program run here, is built with glibc's headers (tools/docker-cc
# passes through without OCAML_EMCC_EMINCLUDE), before the rest.
#   docker-opam SPEC...
set -eu
repo=/opt/ocaml-emcc-repo
if [ -n "$(opam list --installed --short ocaml-option-bytecode-only 2>/dev/null)" ]; then
  if [ ! -f $repo/repo ]; then
    mkdir -p $repo/packages
    echo 'opam-version: "2.0"' > $repo/repo
    opam repository add --this-switch --rank 1 ocaml-emcc $repo >/dev/null
  fi
  changed= reinstall=
  for spec; do
    name=${spec%%.*}
    f=$repo/packages/$name/$spec/opam
    [ ! -f "$f" ] || continue
    raw=$(opam show --raw "$spec")
    case $name in
      dune)
        fixed=$(printf '%s\n' "$raw" | sed '/^build: \[$/a ["sed" "-i" "s/Exe.Linkage.native ]/Exe.Linkage.native_or_custom (Compilation_context.ocaml shared_cctx) ]/" "src/dune_rules/ctypes/ctypes_rules.ml"]') ;;
      *)
        fixed=$(printf '%s\n' "$raw" |
          awk '/^conflicts:/ { c = 1 } c { gsub(/ *"ocaml-option-bytecode-only"( *\{[^}]*\})?/, "") } c && /]/ { c = 0 } { print }') ;;
    esac
    [ "$fixed" != "$raw" ] || continue
    mkdir -p "$(dirname "$f")"
    printf '%s\n' "$fixed" > "$f"
    changed=1
    if [ "$(opam list --installed --short --columns=version "$name" 2>/dev/null)" = "${spec#*.}" ]; then
      reinstall="$reinstall $name"
    fi
  done
  [ -z "$changed" ] || opam update ocaml-emcc >/dev/null
  # shellcheck disable=SC2086
  [ -z "$reinstall" ] || opam reinstall $reinstall
fi
tools=
for spec; do case $spec in dune.*) tools="$tools $spec" ;; esac; done
# shellcheck disable=SC2086
[ -z "$tools" ] || OCAML_EMCC_EMINCLUDE= opam install $tools
opam install "$@"
