#!/bin/sh
# ocamlmklib replacement for the wasm32/wasm64 (emscripten) toolchains.
#
# Only the C side of ocamlmklib is emulated: it builds lib<name>.a with emar
# from the given objects.  Shared libraries do not exist under emscripten, so
# when dll<name>.so is expected (no -custom) a placeholder is written: an
# empty host shared object, because ocamlc parses the ELF of every -dllib
# when it links a bytecode executable.  `ocaml-emcc link` never reads it, it
# maps dll<name> back to lib<name>.a.
#
# OCaml objects (.cmo/.cmx/.cma...) are forwarded to the host ocamlmklib, so
# that `ocamlmklib -o foo foo.cmo foo.o` style invocations still produce the
# OCaml archive.

set -e

: "${OCAML_EMCC_HOST_BIN:?OCAML_EMCC_HOST_BIN not set}"
EMAR=${EMAR:-emar}

# Also first in dune's PATH, for rules running `ocamlmklib` themselves (yaml's
# vendored libyaml): host objects (dune's host context) go to the host tool.
for a in "$@"; do
  case "$a" in
    *.o)
      if [ -f "$a" ] && [ "$(head -c 4 "$a" | od -An -tx1 | tr -d ' \n')" != 0061736d ]; then
        exec "$OCAML_EMCC_HOST_BIN/ocamlmklib" "$@"
      fi ;;
  esac
done

name=a
cname=
custom=no
objs=
ocaml_args=
has_ocaml=no

while [ $# -gt 0 ]; do
  case "$1" in
    -o) name=$2; ocaml_args="$ocaml_args -o $2"; shift ;;
    -oc) cname=$2; ocaml_args="$ocaml_args -oc $2"; shift ;;
    -custom) custom=yes; ocaml_args="$ocaml_args -custom" ;;
    -ocamlc|-ocamlopt|-ccopt|-ldopt|-dllpath|-rpath|-R|-L|-F|-framework)
      ocaml_args="$ocaml_args $1 $2"; shift ;;
    *.o|*.a|*.obj|*.lib) objs="$objs $1" ;;
    *.cmo|*.cma|*.cmx|*.cmxa|*.ml|*.mli)
      has_ocaml=yes; ocaml_args="$ocaml_args $1" ;;
    *) ocaml_args="$ocaml_args $1" ;;
  esac
  shift
done

[ -n "$cname" ] || cname=$name

# -o dir/foo -> dir/libfoo.a, dir/dllfoo.so (like the real ocamlmklib)
case "$cname" in
  */*) cdir=${cname%/*}/; cbase=${cname##*/} ;;
  *) cdir=; cbase=$cname ;;
esac

if [ -n "$objs" ]; then
  rm -f "${cdir}lib$cbase.a"
  # shellcheck disable=SC2086
  $EMAR rcs "${cdir}lib$cbase.a" $objs
  if [ "$custom" = no ]; then
    dll="${cdir}dll$cbase.so"
    printf '' | ${OCAML_EMCC_HOST_CC:-cc} -shared -x c -o "$dll" - 2>/dev/null || : > "$dll"
  fi
fi

if [ "$has_ocaml" = yes ]; then
  # Let the host tool build the .cma/.cmxa (records -cclib/-dllib flags).
  # shellcheck disable=SC2086
  exec "$OCAML_EMCC_HOST_BIN/ocamlmklib" $ocaml_args
fi
